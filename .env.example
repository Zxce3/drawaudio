# Optional: search engine ownership tokens, added to the home page as meta tags at build time.
# In GitHub Actions set them as repository variables instead (Settings > Secrets and variables > Actions > Variables):
#   GOOGLE_SITE_VERIFICATION and BING_SITE_VERIFICATION. See docs/search-console.md.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
