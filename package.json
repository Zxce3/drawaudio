{
  "name": "drawaudio",
  "description": "Draw notes on a grid and hear them as music. A multi-track sequencer and synth for the browser that works offline.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zxce3/drawaudio.git"
  },
  "homepage": "https://drawaudio.zxce3.net/",
  "license": "MIT",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate-impulse": "ts-node --esm scripts/generate-impulse.ts",
    "test": "bun test",
    "audit:seo": "bun scripts/audit-seo.ts"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.73.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.4.4",
    "bits-ui": "^2.20.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@types/node": "^22.13.5",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "wavefile": "^11.0.0"
  }
}
